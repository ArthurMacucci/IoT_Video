{
  "name": "estulanches",
  "version": "1.0.0",
  "description": "Sistema de gestão de cardápio e pedidos da cantina escolar EstuLanches",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "npm run test:unit && npm run test:integration",
